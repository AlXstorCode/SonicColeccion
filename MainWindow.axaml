<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SonicColeccion.MainWindow"
        Title="SonicColeccion">
    <Grid ColumnDefinitions="300,*" Margin="15">

    <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,15,0">
        <TextBlock Text="Colección de juegos de Sonic" FontSize="18" FontWeight="Bold"/>

        <TextBlock Text="Título"/>
        <TextBox x:Name="txtTitulo"/>
        <TextBlock Text="Año"/>
        <TextBox x:Name="txtAnno"/>
        <TextBlock Text="Consola"/>
        <TextBox x:Name="txtConsola"/>

        <TextBlock Text="Estado"/>
        <ComboBox x:Name="cmbEstado" HorizontalAlignment="Stretch"/>

        <TextBlock Text="Calificación (1 a 10)"/>
        <TextBox x:Name="txtCalificacion"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="btnGuardar" Content="Guardar" Click="BtnGuardar_Click"/>
            <Button x:Name="btnActualizar" Content="Actualizar" Click="BtnActualizar_Click"/>
            <Button x:Name="btnEliminar" Content="Eliminar"/>
            <Button x:Name="btnLimpiar" Content="Limpiar"/>
        </StackPanel>

        <TextBlock x:Name="lblMensaje" TextWrapping="Wrap"/>
    </StackPanel>

    <ListBox x:Name="lstJuegos" Grid.Column="1"/>
    <ListBox x:Name="lstJuegos" Grid.Column="1" SelectionChanged="LstJuegos_SelectionChanged"/>

</Grid>
</Window>
